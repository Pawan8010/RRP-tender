# PostgreSQL connection string
DATABASE_URL="postgresql://gem_user:gem_password@localhost:5432/gem_tenders?schema=public"

# API server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call the API
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Cron expression for automatic scraping. Leave empty to disable.
SCRAPE_CRON="0 */6 * * *"

# GeM portal base URL (public search/listing page)
GEM_BASE_URL=https://bidplus.gem.gov.in

# Run Playwright in headless mode (true/false)
SCRAPER_HEADLESS=true

# Max concurrent scraper page workers
SCRAPER_CONCURRENCY=2

# Max retries per page fetch
SCRAPER_MAX_RETRIES=3

# Navigation timeout (ms)
SCRAPER_TIMEOUT_MS=45000
SCRAPER_MAX_PAGES=0
SCRAPER_REQUEST_DELAY_MS=50
SCRAPER_API_CONCURRENCY=24
SCRAPER_START_PAGE=1
